# Эталонный список ключей конфигурации Nutri Radar.
#
# Скопировать и заполнить:  cp .env.example .env
# Файл .env в репозиторий не попадает (см. .gitignore).
#
# Актуальность этого файла проверяется тестом tests/test_config.py: каждое поле
# Settings обязано иметь здесь ключ. Добавил параметр в config.py — добавь сюда.
#
# Вложенные группы читаются с префиксом и двойным подчёркиванием: DB__HOST.
# Списки задаются как JSON-массив.

# =============================================================================
# Приложение
# =============================================================================
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=DEBUG
# local | ci | production
ENVIRONMENT=local
# true — логи одной JSON-строкой на запись (контейнеры, CI)
JSON_LOGS=false

# =============================================================================
# PostgreSQL
# =============================================================================
# Эти же значения docker-compose подставляет в контейнер Postgres —
# отдельных POSTGRES_* переменных не нужно, источник истины один.
DB__HOST=localhost
# ВНИМАНИЕ: если на машине уже установлен PostgreSQL как служба, он занимает
# 5432, и подключение молча уйдёт в него вместо контейнера (симптом:
# asyncpg.ConnectionDoesNotExistError, при этом в логах контейнера ни одной
# попытки подключения). Проверить занятость порта и при конфликте поставить
# сюда 5433 — compose пробросит 5433 на хосте в 5432 внутри контейнера.
DB__PORT=5432
DB__USER=nutri
DB__PASSWORD=local_dev_password
DB__NAME=nutri_radar
DB__POOL_SIZE=5
# Дефолт asyncpg 60 с — недоступная база подвесила бы health-check на минуту
DB__CONNECT_TIMEOUT_S=10.0
# Эхо SQL отдельным флагом, а не через LOG_LEVEL: на DEBUG оно забивает вывод
DB__ECHO_SQL=false

# =============================================================================
# Ollama — локальные модели
# =============================================================================
OLLAMA__BASE_URL=http://localhost:11434
# Модель извлечения: 3B в q4. 7B+ не влезает в 6 ГБ VRAM
OLLAMA__MODEL=qwen2.5:3b-instruct-q4_K_M
# Эмбеддинги обязательно мультиязычные — составы на десятках языков
OLLAMA__EMBEDDING_MODEL=bge-m3
OLLAMA__EMBEDDING_DIM=1024
# КРИТИЧНО: дефолт Ollama 4096 и подбирается по VRAM, то есть молча режет вход
OLLAMA__NUM_CTX=8192
OLLAMA__TEMPERATURE=0.0
OLLAMA__MAX_OUTPUT_TOKENS=2048
# Модели грузятся по очереди: 6 ГБ VRAM не переживут две сразу
OLLAMA__KEEP_ALIVE=5m
OLLAMA__TIMEOUT_S=120.0
# Единица по измерению, а не из осторожности: A/B на одних продуктах дал
# 838 с при 2 и 817 с при 1 — ускорения нет, память тратится вдвое (ADR-017)
OLLAMA__MAX_CONCURRENCY=1

# =============================================================================
# Anthropic — агент (M6) и эталон в evals (M3)
# =============================================================================
# На M0 не обязателен: health-check сообщит об отсутствии как WARN, не как FAIL
ANTHROPIC__API_KEY=
ANTHROPIC__MODEL=claude-sonnet-5
# Дешёвая модель для массовых прогонов вроде zero-shot в M4
ANTHROPIC__CHEAP_MODEL=claude-haiku-4-5-20251001
ANTHROPIC__MAX_OUTPUT_TOKENS=2048
ANTHROPIC__TIMEOUT_S=60.0

# =============================================================================
# Сбор корпуса из дампа Open Food Facts
# =============================================================================
# Parquet-дамп лежит ТОЛЬКО на HuggingFace, на static.openfoodfacts.org его нет
INGEST__DUMP_URL=https://huggingface.co/datasets/openfoodfacts/product-database/resolve/main/food.parquet
INGEST__DELTA_INDEX_URL=https://static.openfoodfacts.org/data/delta/index.txt
# Дамп ~10 ГБ, каталог в .gitignore
INGEST__DATA_DIR=data
# Языки составов (ADR-002)
INGEST__LANGUAGES=["en","ru","de","fr","pl"]
# Категории корпуса (ADR-002). Теги подбираются по факту на дампе
INGEST__CATEGORY_TAGS=["en:sweet-snacks","en:salty-snacks","en:biscuits-and-cakes","en:chocolates","en:confectioneries","en:sweetened-beverages","en:yogurts","en:cheeses","en:breakfast-cereals"]
# Только продукты, которые хоть раз сканировали: отсекает заброшенные записи
INGEST__REQUIRE_SCANNED=true
# Составы короче этого не несут информации
INGEST__MIN_INGREDIENTS_LENGTH=10
INGEST__BATCH_SIZE=1000
# Выборка для ingest probe. Удалённое чтение 20 тыс. строк ~200 с
INGEST__PROBE_SAMPLE_ROWS=20000
# Без лимита DuckDB на файле 7,7 ГБ может съесть всю память
INGEST__DUCKDB_MEMORY_LIMIT=4GB
# Доля пропусков выше этой — признак сломанного фильтра, а не плохих данных
INGEST__MAX_SKIP_SHARE=0.05
# Целевая вилка аналитического корпуса (раздел 6 брифа)
INGEST__CORPUS_MIN_SIZE=50000
INGEST__CORPUS_MAX_SIZE=150000
# Скачивание дампа 7,7 ГБ: докачка по Range и ретраи обязательны
INGEST__DOWNLOAD_CHUNK_SIZE=8388608
INGEST__DOWNLOAD_MAX_RETRIES=5
INGEST__DOWNLOAD_TIMEOUT_S=300.0

# =============================================================================
# Извлечение структуры состава (M2)
# =============================================================================
# Версия промпта уезжает в БД рядом с результатом — без неё не сравнить версии
EXTRACT__PROMPT_VERSION=v3
# Размер LLM-корпуса. Бриф просил 3-5 тысяч, но замер дал 20,4 с на продукт:
# 3000 — это 12-17 часов, втрое выше порога. Сужено по измерению (ADR-017)
EXTRACT__CORPUS_SIZE=1200
# Доля со смещением в unknown_ingredients_n > 0 (ADR-006), остальное — контроль
EXTRACT__UNKNOWN_SHARE=0.7
# Повторный запуск обязан дать ТУ ЖЕ выборку
EXTRACT__RANDOM_SEED=42
# Доля невалидных ответов, выше которой полный прогон запускать нельзя
EXTRACT__MAX_INVALID_SHARE=0.1
# Порог экстраполяции замера в часах
EXTRACT__MAX_RUN_HOURS=6.0
# Замер перед полным прогоном: 20 продуктов, одни и те же для всех версий
EXTRACT__BENCHMARK_SIZE=20
# Сколько неизвестных имён показывает `extract dict unknown`
EXTRACT__UNKNOWN_REPORT_TOP=50
# Результаты уходят в БД после каждого батча: Ctrl+C стоит не больше батча
EXTRACT__BATCH_SIZE=50
# Ретраи ТОЛЬКО на недоступности модели; невалидный разбор не ретраится
EXTRACT__MAX_RETRIES=3
EXTRACT__RETRY_BACKOFF_S=2.0
# Столько отказов подряд означают, что Ollama упала, а не что состав трудный
EXTRACT__MAX_CONSECUTIVE_FAILURES=10

# =============================================================================
# Оценка качества (M3)
# =============================================================================
# Сколько продуктов размечает человек: по 20 на каждый из пяти языков.
# Меньше 20 на язык не даёт судить о разнице между языками.
EVALS__GOLD_SIZE=100
# Свой seed, а не общий с extract: смена seed отбора корпуса не должна
# переставлять эталонную выборку — размеченное привязано к конкретным продуктам.
EVALS__RANDOM_SEED=20260728
# На сколько пунктов может просесть F1, прежде чем гейт уронит сборку.
EVALS__MAX_F1_DROP=3.0
# Относительная разница, ниже которой числа одного прогона неразличимы.
# ADR-018 измерил разброс между идентичными прогонами локальной модели: 20%.
EVALS__SIGNIFICANT_DIFF_SHARE=0.20

# =============================================================================
# Аналитика (M4)
# =============================================================================
# Свой seed, а не общий с extract и evals: смена одного не должна
# переставлять train/test другого — иначе числа двух прогонов посчитаны
# на разных сплитах и несравнимы.
ANALYTICS__RANDOM_SEED=20260905
# Доля теста. 20% от 131 тысячи — 26 тысяч продуктов.
ANALYTICS__TEST_SIZE=0.2
# Составы короче этого — «-», «н/д» и мусор: учиться нечему, шум есть.
ANALYTICS__MIN_TEXT_LENGTH=20
# Размер общей подвыборки, на которой меряются ВСЕ подходы. Бриф запрещает
# гонять через LLM больше нескольких тысяч продуктов, а сравнивать подходы
# можно только на одном и том же множестве.
ANALYTICS__LLM_SUBSET_SIZE=1000
# Сколько продуктов идёт в замер скорости перед полным прогоном.
ANALYTICS__BENCHMARK_SIZE=200
# Сколько продуктов идёт в обучение на эмбеддингах. Замер 2026-09-05:
# 0,099 с на продукт, то есть весь корпус — 219 минут GPU. Тест
# векторизуется целиком, train режется.
ANALYTICS__EMBED_TRAIN_SIZE=25000
# Класс с меньшим числом примеров исключается из задачи. nova_group=2
# встречается 25 раз на 138 254: научиться нечему, а macro-F1 просядет
# на пятую часть из-за величины, про которую нельзя сказать ничего.
ANALYTICS__MIN_CLASS_PRODUCTS=100
# Версии промптов zero-shot.
ANALYTICS__GRADE_PROMPT_VERSION=grade_v1
ANALYTICS__NOVA_PROMPT_VERSION=nova_v1
# Символьные n-граммы, а не слова: корпус многоязычный, и словарная
# токенизация развела бы sucre, Zucker и сахар по трём признакам.
ANALYTICS__TFIDF_ANALYZER=char_wb
ANALYTICS__TFIDF_NGRAM_MIN=3
ANALYTICS__TFIDF_NGRAM_MAX=5
# Признак из двух документов на 131 тысячу — опечатка, а не сигнал.
ANALYTICS__TFIDF_MIN_DF=5
ANALYTICS__TFIDF_MAX_FEATURES=200000
# Классы несбалансированы (44% против 3,7%). Без балансировки логрегрессия
# вырождается в «всегда e»: это её локальный оптимум по accuracy.
ANALYTICS__CLASS_WEIGHT=balanced
ANALYTICS__LOGREG_C=1.0
ANALYTICS__LOGREG_MAX_ITER=400

# =============================================================================
# Поиск и RAG (M5)
# =============================================================================
# Сколько профилей уходит в Ollama одним запросом. Профиль длиннее голого
# состава, поэтому батч меньше, чем в M4.
RETRIEVAL__EMBED_BATCH_SIZE=24
# Сколько строк пишется в БД одной транзакцией. Запись дешевле генерации,
# и дробить её так же мелко значит платить за круги в базу.
RETRIEVAL__DB_BATCH_SIZE=500
RETRIEVAL__BENCHMARK_SIZE=200
# HNSW. Значения из документации pgvector. Крутить стоит ef_search первым,
# m — последним и только если recall упёрся в потолок.
RETRIEVAL__HNSW_M=16
RETRIEVAL__HNSW_EF_CONSTRUCTION=64
# Query-time, не меньше LIMIT.
RETRIEVAL__HNSW_EF_SEARCH=100
# Дефолт Postgres (64 МБ) превращает сборку HNSW на 146 тысячах векторов
# в часы дискового шуршания.
RETRIEVAL__MAINTENANCE_WORK_MEM=2GB
# Сколько продуктов возвращает поиск по умолчанию.
RETRIEVAL__TOP_K=5

# =============================================================================
# Выбор провайдера LLM
# =============================================================================
# ollama — локальная модель (массовый прогон), anthropic — облако (агент, эталон)
LLM__PROVIDER=ollama
