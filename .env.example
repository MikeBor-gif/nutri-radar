# Эталонный список ключей конфигурации Nutri Radar.
#
# Скопировать и заполнить:  cp .env.example .env
# Файл .env в репозиторий не попадает (см. .gitignore).
#
# Актуальность этого файла проверяется тестом tests/test_config.py: каждое поле
# Settings обязано иметь здесь ключ. Добавил параметр в config.py — добавь сюда.
#
# Вложенные группы читаются с префиксом и двойным подчёркиванием: DB__HOST.
# Списки задаются как JSON-массив.

# =============================================================================
# Приложение
# =============================================================================
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=DEBUG
# local | ci | production
ENVIRONMENT=local
# true — логи одной JSON-строкой на запись (контейнеры, CI)
JSON_LOGS=false

# =============================================================================
# PostgreSQL
# =============================================================================
# Эти же значения docker-compose подставляет в контейнер Postgres —
# отдельных POSTGRES_* переменных не нужно, источник истины один.
DB__HOST=localhost
# ВНИМАНИЕ: если на машине уже установлен PostgreSQL как служба, он занимает
# 5432, и подключение молча уйдёт в него вместо контейнера (симптом:
# asyncpg.ConnectionDoesNotExistError, при этом в логах контейнера ни одной
# попытки подключения). Проверить занятость порта и при конфликте поставить
# сюда 5433 — compose пробросит 5433 на хосте в 5432 внутри контейнера.
DB__PORT=5432
DB__USER=nutri
DB__PASSWORD=local_dev_password
DB__NAME=nutri_radar
DB__POOL_SIZE=5
# Дефолт asyncpg 60 с — недоступная база подвесила бы health-check на минуту
DB__CONNECT_TIMEOUT_S=10.0
# Эхо SQL отдельным флагом, а не через LOG_LEVEL: на DEBUG оно забивает вывод
DB__ECHO_SQL=false

# =============================================================================
# Ollama — локальные модели
# =============================================================================
OLLAMA__BASE_URL=http://localhost:11434
# Модель извлечения: 3B в q4. 7B+ не влезает в 6 ГБ VRAM
OLLAMA__MODEL=qwen2.5:3b-instruct-q4_K_M
# Эмбеддинги обязательно мультиязычные — составы на десятках языков
OLLAMA__EMBEDDING_MODEL=bge-m3
OLLAMA__EMBEDDING_DIM=1024
# КРИТИЧНО: дефолт Ollama 4096 и подбирается по VRAM, то есть молча режет вход
OLLAMA__NUM_CTX=8192
OLLAMA__TEMPERATURE=0.0
OLLAMA__MAX_OUTPUT_TOKENS=2048
# Модели грузятся по очереди: 6 ГБ VRAM не переживут две сразу
OLLAMA__KEEP_ALIVE=5m
OLLAMA__TIMEOUT_S=120.0
# Неограниченный веер запросов положит GPU
OLLAMA__MAX_CONCURRENCY=2

# =============================================================================
# Anthropic — агент (M6) и эталон в evals (M3)
# =============================================================================
# На M0 не обязателен: health-check сообщит об отсутствии как WARN, не как FAIL
ANTHROPIC__API_KEY=
ANTHROPIC__MODEL=claude-sonnet-5
# Дешёвая модель для массовых прогонов вроде zero-shot в M4
ANTHROPIC__CHEAP_MODEL=claude-haiku-4-5-20251001
ANTHROPIC__MAX_OUTPUT_TOKENS=2048
ANTHROPIC__TIMEOUT_S=60.0

# =============================================================================
# Сбор корпуса из дампа Open Food Facts
# =============================================================================
# Parquet-дамп лежит ТОЛЬКО на HuggingFace, на static.openfoodfacts.org его нет
INGEST__DUMP_URL=https://huggingface.co/datasets/openfoodfacts/product-database/resolve/main/food.parquet
INGEST__DELTA_INDEX_URL=https://static.openfoodfacts.org/data/delta/index.txt
# Дамп ~10 ГБ, каталог в .gitignore
INGEST__DATA_DIR=data
# Языки составов (ADR-002)
INGEST__LANGUAGES=["en","ru","de","fr","pl"]
# Категории корпуса (ADR-002). Теги подбираются по факту на дампе
INGEST__CATEGORY_TAGS=["en:snacks","en:sweet-snacks","en:salty-snacks","en:biscuits-and-cakes","en:chocolates","en:confectioneries","en:beverages","en:sweetened-beverages","en:dairies","en:yogurts","en:cheeses","en:breakfasts","en:breakfast-cereals"]
# Составы короче этого не несут информации
INGEST__MIN_INGREDIENTS_LENGTH=10
INGEST__BATCH_SIZE=1000
# Выборка для ingest probe. Удалённое чтение 20 тыс. строк ~200 с
INGEST__PROBE_SAMPLE_ROWS=20000
# Без лимита DuckDB на файле 7,7 ГБ может съесть всю память
INGEST__DUCKDB_MEMORY_LIMIT=4GB
# Доля пропусков выше этой — признак сломанного фильтра, а не плохих данных
INGEST__MAX_SKIP_SHARE=0.05
# Целевая вилка аналитического корпуса (раздел 6 брифа)
INGEST__CORPUS_MIN_SIZE=50000
INGEST__CORPUS_MAX_SIZE=150000
# Скачивание дампа 7,7 ГБ: докачка по Range и ретраи обязательны
INGEST__DOWNLOAD_CHUNK_SIZE=8388608
INGEST__DOWNLOAD_MAX_RETRIES=5
INGEST__DOWNLOAD_TIMEOUT_S=300.0

# =============================================================================
# Выбор провайдера LLM
# =============================================================================
# ollama — локальная модель (массовый прогон), anthropic — облако (агент, эталон)
LLM__PROVIDER=ollama
